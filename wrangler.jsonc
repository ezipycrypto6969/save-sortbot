// Cloudflare Workers deploy for the SaveSort website + Pro API (runs on every push to main).
{
  "name": "save-sortbot",
  "main": "site/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site/public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "404-page" },
  "observability": { "enabled": true },
  // Rate limits (per Cloudflare location): breakdowns 10 a minute per Pro member and per IP; owner/activate 5 a minute per IP.
  "ratelimits": [
    { "name": "BD_LIMIT", "namespace_id": "7301", "simple": { "limit": 10, "period": 60 } },
    { "name": "OWNER_LIMIT", "namespace_id": "7302", "simple": { "limit": 5, "period": 60 } }
  ]
}
