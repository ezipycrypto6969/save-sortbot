// Cloudflare Workers deploy for the SaveSort website + Pro API (runs on every push to main).
{
  "name": "save-sortbot",
  "main": "site/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site/public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true }
}
